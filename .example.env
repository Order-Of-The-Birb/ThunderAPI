# Hosting settings
PORT=8001
HOST=127.0.0.1


# Logging level (INFO recommended unless developing)
LOG_LEVEL=INFO

# IPs to trust for X-Forwarded-For (proxies like a Cloudflare tunnel). Use "*" to trust all,
# or a CIDR/subnet like "172.18.0.0/16" to only trust the Docker network.
FORWARDED_ALLOW_IPS=*

# Rate limiting
LOGIN_RATE_LIMIT=25/minute
REGULAR_RATE_LIMIT=100/minute

# Server account settings
SERVER_EMAIL=
SERVER_PASS=

# Linux Systemd/Docker settings
UID=
GID=
